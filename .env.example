# ==========================================================
# IBVAP / Vigilant Vision Environment Configuration Template
# Copy this file to .env and configure your variables
# ==========================================================

# Database Connection (PostgreSQL or SQLite fallback)
# PostgreSQL: postgresql://postgres:postgres@localhost:5432/ibvap
DATABASE_URL=sqlite:///ibvap.db

# YOLOv8 AI Model Settings
YOLO_MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
FRAME_SKIP=2

# Event Processing & Deduplication Tuning
TEMPORAL_WINDOW_SECONDS=5.0
SPATIAL_IOU_THRESHOLD=0.30
MIN_CONSECUTIVE_FRAMES=2

# Server Ports
API_HOST=0.0.0.0
API_PORT=8000
